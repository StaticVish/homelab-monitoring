[Unit]
Description=Prometheus Tailscale Service Discovery HTTP Service
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=/usr/local/bin/tailscale_sd.py --serve --port 8080
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
