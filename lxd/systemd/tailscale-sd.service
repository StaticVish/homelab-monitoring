[Unit]
Description=Tailscale Dynamic Service Discovery for VictoriaMetrics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/tailscale_sd.py --serve --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
