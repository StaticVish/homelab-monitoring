      "id": 100,
      "title": "Agent Context Window & Token Consumption",
      "type": "row"
    },
    {
      "title": "Average Context Window Size per Request (Tokens)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 10,
      "targets": [
        {
          "expr": "sum by (api_key_alias) (rate(litellm_input_tokens_metric_total[2m])) / sum by (api_key_alias) (rate(litellm_proxy_total_requests_metric_total[2m]))",
          "legendFormat": "{{api_key_alias}} (Context Size)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50000
              },
              {
                "color": "red",
                "value": 100000
              }
            ]
          }
        }
      }
    },
    {
      "title": "Context Window / Input Tokens Rate (Tokens/sec)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (api_key_alias) (rate(litellm_input_tokens_metric_total[1m]))",
          "legendFormat": "{{api_key_alias}} (Input)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      }
    },
